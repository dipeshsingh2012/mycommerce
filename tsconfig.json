{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@mycommerce/counter-check": ["../counter-check/src/index.ts"],
      "@mycommerce/homepage-ui": ["../homepage-ui/src/index.ts"],
      "@mycommerce/discovery-ui": ["../discovery-ui/src/index.ts"],
      "@mycommerce/product-page-ui": ["../product-page-ui/src/index.ts"],
      "@mycommerce/cart-ui": ["../cart-ui/src/index.ts"],
      "@mycommerce/checkout-ui": ["../checkout-ui/src/index.ts"],
      "@mycommerce/search-ui": ["../search-ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
